# ── Database ─────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# ── LLM ──────────────────────────────────────────────
LLM_API_KEY=sk-...

# ── NextAuth v5 (required) ───────────────────────────
# Generate with: openssl rand -base64 48
AUTH_SECRET=
# AUTH_URL only needed if Vercel cannot auto-infer (e.g. custom domain)
# AUTH_URL=https://your-domain.com

# ── OAuth Providers (optional — buttons show when set) ────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Cloudflare Turnstile (optional — CAPTCHA bypassed when unset) ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Email via Resend (optional — email verification bypassed when unset) ──
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com

# ── Rate limiting via Upstash Redis (optional — in-memory fallback when unset) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Legacy (will be removed after full migration) ────
JWT_SECRET=
